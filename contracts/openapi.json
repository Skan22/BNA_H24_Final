  "components": {
    "schemas": {
      "DiagnoseBody": {
        "properties": {
          "dossier_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^DOS-[A-Z]{3}-\\d{6}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dossier Id"
          },
          "question": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Question"
          },
          "locale": {
            "type": "string",
            "enum": [
              "fr",
              "ar",
              "en"
            ],
            "title": "Locale",
            "default": "fr"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "DiagnoseBody"
      },
      "EscalationBody": {
        "properties": {
          "diagnosis_id": {
            "type": "string",
            "pattern": "^TR-[0-9a-f]{12}$",
            "title": "Diagnosis Id"
          },
          "note": {
            "type": "string",
            "maxLength": 2000,
            "title": "Note",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "diagnosis_id"
        ],
        "title": "EscalationBody"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "enum": [
              "agent",
              "client"
            ],
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password"
          },
          "dossier_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^DOS-[A-Z]{3}-\\d{6}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dossier Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest"
      },
      "PreviewBody": {
        "properties": {
          "cause_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^C-[A-Z]{3}-\\d{3}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cause Id"
          },
          "step": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 9.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Step"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "PreviewBody"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
