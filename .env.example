# Copier en `.env` (ignoré par git) et remplir. Pas de guillemets ni d'espaces autour du « = » : make et docker compose lisent ce fichier.
# NE JAMAIS committer la clé, ni la coller dans un ticket ou un message.

# --- Modèle de langage (Groq) -------------------------------------------------------------------
GROQ_API_KEY=
BOUSSOLA_LLM=groq
# Modèles : vérifier ce que votre compte autorise avec `make llm-check` ; ces valeurs sont des défauts non garantis.
GROQ_MODEL_STRONG=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b

# --- Plateforme (valeurs de démonstration : à changer avant tout partage) ---------------------------
AGENT_PASSWORD=agent-demo-change-me
CLIENT_PASSWORD=client-demo-change-me
EVALUATOR_TOKEN=local-evaluator-change-me
BOUSSOLA_MOCK_KEY=local-mock-change-me
DEMO_MODE=true
